[Unit]
Description=EdgeConnect three-seed Elo confirmation campaign
Wants=network-online.target
After=network-online.target
OnFailure=edgeconnect-startrain-continuity.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@TRAINING_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=@TRAINING_DIR@
Environment=PATH=@TRAINING_DIR@/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=@TRAINING_DIR@/.venv/bin/python @TRAINING_DIR@/scripts/check_training_ipc.py --user @USER@
ExecStart=@TRAINING_DIR@/.venv/bin/python @TRAINING_DIR@/scripts/run_staged_elo_pipeline.py --confirmation-campaign @CONFIRMATION_CAMPAIGN@
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=30
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=infinity
TimeoutStopSec=1000
OOMPolicy=stop
LimitNOFILE=1048576
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
